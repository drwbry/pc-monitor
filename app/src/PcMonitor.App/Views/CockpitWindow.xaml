<Window x:Class="PcMonitor.App.Views.CockpitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marsh PC Monitor" Width="1080" Height="720" MinWidth="900" MinHeight="600"
        Style="{StaticResource ThemedWindow}">
  <Window.Resources>
    <!-- Sparkline: area + line in a fixed 220x36 box, scaled to the slot. -->
    <DataTemplate x:Key="SparkChart">
      <Viewbox Stretch="Fill" Height="36">
        <Canvas Width="220" Height="36">
          <Polygon Points="{Binding Area}" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
          <Polyline Points="{Binding Line}" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
        </Canvas>
      </Viewbox>
    </DataTemplate>

    <Style x:Key="TileCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Pill}" Background="{StaticResource AccentTintBrush}" Margin="0,0,8,0"
                Visibility="{Binding GameModeActive, Converter={StaticResource BoolToVisible}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Game Mode on" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Pill}" Background="{Binding HealthTint}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding HealthBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding HealthLabel}" Foreground="{Binding HealthBrush}" FontWeight="SemiBold" FontSize="12"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentTintBrush}" Margin="0,0,12,0">
          <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15"
                     Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Marsh PC Monitor" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="10,4,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <!-- ===== Banner + help ===== -->
    <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12"
            Visibility="{Binding TempBanner, Converter={StaticResource NullToCollapsed}}">
      <DockPanel>
        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarnBrush}"
                   VerticalAlignment="Top" Margin="0,2,10,0"/>
        <TextBlock Text="{Binding TempBanner}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
      </DockPanel>
    </Border>

    <Expander Grid.Row="2" Header="How to use this" Style="{StaticResource SubtleExpander}" Margin="2,0,0,12"
              IsExpanded="{Binding ExplainerCollapsed, Converter={StaticResource InvertBool}}">
      <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" LineHeight="19" MaxWidth="820" HorizontalAlignment="Left">
        This is your "is anything wrong?" cockpit. The tiles show what is happening right now and
        issue cards appear when something crosses a threshold. For a deeper look, click Capture
        Diagnostic (full snapshot, 10-20s) or Live Probe (5s trace), then "Copy Claude prompt" and paste
        it into Claude Code in WSL. Files land in Documents\SysLogs\ next to the hourly snapshots.
        Game Mode closes background apps, WSL and the Cowork VM before you play, and brings them back after.
      </TextBlock>
    </Expander>

    <!-- ===== Live tiles ===== -->
    <Grid Grid.Row="3" Margin="0,0,-12,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource TileCard}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="last 60s" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
          </DockPanel>
          <TextBlock Text="{Binding Live.CpuPercent}" Style="{StaticResource BigNumber}" Margin="0,4,0,0"/>
          <TextBlock Text="all cores" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ContentControl Content="{Binding Live.CpuSpark}" ContentTemplate="{StaticResource SparkChart}"
                          Foreground="{Binding Live.CpuBrush}" Tag="{StaticResource CpuFillBrush}" Focusable="False"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource TileCard}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="last 60s" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
            <TextBlock Text="MEMORY" Style="{StaticResource Caption}"/>
          </DockPanel>
          <TextBlock Text="{Binding Live.RamText}" Style="{StaticResource BigNumber}" Margin="0,4,0,0"/>
          <TextBlock Text="{Binding Live.RamSub}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ContentControl Content="{Binding Live.RamSpark}" ContentTemplate="{StaticResource SparkChart}"
                          Foreground="{Binding Live.RamBrush}" Tag="{StaticResource RamFillBrush}" Focusable="False"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource TileCard}">
        <DockPanel LastChildFill="False">
          <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="warn 85° · max 95°" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
            <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Live.TempText}" Style="{StaticResource BigNumber}" Margin="0,4,0,0"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Live.TempSub}" Style="{StaticResource Muted}"/>
          <ProgressBar DockPanel.Dock="Bottom" Style="{StaticResource Meter}" Value="{Binding Live.TempFraction, Mode=OneWay}"
                       Foreground="{Binding Live.TempBrush}" Height="6" Margin="0,0,0,4"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="3" Style="{StaticResource TileCard}">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Top" Text="DRIVE C:" Style="{StaticResource Caption}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Live.DriveCText}" Style="{StaticResource BigNumber}" Margin="0,4,0,0"/>
          <TextBlock DockPanel.Dock="Top" Text="free space" Style="{StaticResource Muted}"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,2">
            <Ellipse Width="8" Height="8" Fill="{Binding Live.DriveBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="warn under 20 GB" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== Body: issues + trends | top processes ===== -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="360"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="Active issues" Style="{StaticResource SectionTitle}"/>
              <Border Style="{StaticResource Pill}" Background="{StaticResource Surface2Brush}" Margin="8,0,0,0" Padding="7,1"
                      HorizontalAlignment="Left" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding Issues.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
              </Border>
            </DockPanel>

            <Grid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding HasIssues, Converter={StaticResource InvertBoolToVisible}}">
                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                             Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Nothing needs attention" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBlock Text="Cards appear here when something crosses a threshold." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisible}}">
                <ItemsControl ItemsSource="{Binding Issues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Margin="0,0,0,8" Padding="0,0,12,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border CornerRadius="8,0,0,8" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                          <StackPanel Grid.Column="1" Margin="12,10,0,10">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}"
                                         Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Border>

        <!-- 24h trends -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="{Binding Sparkline.Available, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock DockPanel.Dock="Right" Text="hourly snapshots" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
              <TextBlock Text="Last 24 hours" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Sparkline.CpuSummary}" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
                <ContentControl Content="{Binding Sparkline.Cpu}" ContentTemplate="{StaticResource SparkChart}"
                                Foreground="{StaticResource CpuBrush}" Tag="{StaticResource CpuFillBrush}" Focusable="False"/>
              </StackPanel>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="MEMORY" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Sparkline.RamSummary}" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
                <ContentControl Content="{Binding Sparkline.Ram}" ContentTemplate="{StaticResource SparkChart}"
                                Foreground="{StaticResource RamBrush}" Tag="{StaticResource RamFillBrush}" Focusable="False"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="EVENT LOG ERRORS" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Sparkline.ErrorsSummary}" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
                <ContentControl Content="{Binding Sparkline.Errors}" ContentTemplate="{StaticResource SparkChart}"
                                Foreground="{StaticResource ErrBrush}" Tag="{StaticResource ErrFillBrush}" Focusable="False"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Top processes -->
      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="by memory" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
            <TextBlock Text="Top processes" Style="{StaticResource SectionTitle}"/>
          </DockPanel>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NAME" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}"/>
            <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="RAM" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Live.TopProcesses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="64"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding CpuPercent}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Ram}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <ProgressBar Style="{StaticResource Meter}" Value="{Binding RamFraction, Mode=OneWay}" Height="3"
                               Foreground="{StaticResource RamBrush}" Margin="0,6,0,0" Opacity="0.75"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== Action bar ===== -->
    <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
              Command="{Binding CaptureCommand}" CommandParameter="Diagnostic">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Capture Diagnostic"/>
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Command="{Binding CaptureCommand}" CommandParameter="LiveProbe">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Live Probe (5s)"/>
        </StackPanel>
      </Button>

      <Button DockPanel.Dock="Right" Command="{Binding GameModeCommand}" MinWidth="170">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding GameModeActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding GameModeButtonText}"/>
        </StackPanel>
      </Button>
    </DockPanel>
  </Grid>
</Window>
