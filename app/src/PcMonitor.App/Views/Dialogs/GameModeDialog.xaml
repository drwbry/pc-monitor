<Window x:Class="PcMonitor.App.Views.Dialogs.GameModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="560" Height="560"
        Background="#0D1117" Foreground="#C9D1D9" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C9D1D9"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C9D1D9"/>
    </Style>
    <DataTemplate x:Key="RowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontSize="14"/>
          <TextBlock Text="{Binding Note}" Margin="20,0,0,0" FontSize="11" Opacity="0.6"
                     Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Opacity="0.8"
                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Top"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,6,0,8">
      <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" Opacity="0.85"/>
      <TextBlock Text="{Binding ConfigError}" TextWrapping="Wrap" Foreground="#D29922" Margin="0,6,0,0"
                 Visibility="{Binding ConfigError, Converter={StaticResource NullToCollapsed}}"/>
      <TextBlock Text="Reading running apps..." Margin="0,6,0,0" Opacity="0.7"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"/>
    </StackPanel>

    <Border Grid.Row="2" Background="#161B22" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsEditable}"
                        ItemTemplate="{StaticResource RowTemplate}"/>
          <StackPanel Visibility="{Binding HasOptional, Converter={StaticResource BoolToVisible}}" Margin="0,12,0,0">
            <TextBlock Text="Also running - tick to close these too" FontWeight="SemiBold" Opacity="0.85"/>
            <TextBlock Text="Often used while gaming, so left unchecked." FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding OptionalRows}" IsEnabled="{Binding IsEditable}"
                          ItemTemplate="{StaticResource RowTemplate}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Lines}" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding TotalText}" Margin="0,8,0,0" Opacity="0.8"/>
    <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
               Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>

    <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
      <CheckBox DockPanel.Dock="Left" Content="Dry run (show what would happen, change nothing)"
                IsChecked="{Binding DryRun}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                FontSize="11" Opacity="0.7"/>
      <Button DockPanel.Dock="Right" Content="Close" Padding="14,6" Click="OnClose"/>
      <Button DockPanel.Dock="Right" Content="{Binding ConfirmText}" Padding="14,6" Margin="0,0,8,0"
              Command="{Binding ConfirmCommand}" IsDefault="True"/>
    </DockPanel>
  </Grid>
</Window>
