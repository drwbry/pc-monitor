<Window x:Class="PcMonitor.App.Views.Dialogs.GameModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="580" Height="600" MinWidth="480" MinHeight="420"
        Style="{StaticResource ThemedWindow}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="RowTemplate">
      <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Note}" Margin="28,2,0,0" Style="{StaticResource Muted}" FontSize="11"
                       Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentTintBrush}" Margin="0,0,12,0">
        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="15"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,10,0,12">
      <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="13"/>
      <TextBlock Text="{Binding ConfigError}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0"
                 Visibility="{Binding ConfigError, Converter={StaticResource NullToCollapsed}}"/>
      <TextBlock Text="{Binding SkippedText}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Visibility="{Binding SkippedText, Converter={StaticResource NullToCollapsed}}"/>
      <TextBlock Text="Reading running apps..." Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
        <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsEditable}"
                      ItemTemplate="{StaticResource RowTemplate}"/>
        <StackPanel Visibility="{Binding HasOptional, Converter={StaticResource BoolToVisible}}" Margin="0,10,0,0">
          <TextBlock Text="ALSO RUNNING" Style="{StaticResource Caption}"/>
          <TextBlock Text="Often used while gaming, so left unchecked. Tick to close these too."
                     Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/>
          <ItemsControl ItemsSource="{Binding OptionalRows}" IsEnabled="{Binding IsEditable}"
                        ItemTemplate="{StaticResource RowTemplate}"/>
        </StackPanel>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ItemsControl ItemsSource="{Binding Lines}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                        Foreground="{StaticResource MutedBrush}"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{Binding TotalText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                 Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
    </StackPanel>

    <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
      <CheckBox DockPanel.Dock="Left" Content="Dry run" ToolTip="Show what would happen and change nothing"
                IsChecked="{Binding DryRun}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                Foreground="{StaticResource MutedBrush}"/>
      <Button DockPanel.Dock="Right" Content="Close" Click="OnClose"/>
      <Button DockPanel.Dock="Right" Content="{Binding ConfirmText}" Style="{StaticResource AccentButton}"
              Margin="0,0,8,0" Command="{Binding ConfirmCommand}" IsDefault="True"/>
    </DockPanel>
  </Grid>
</Window>
